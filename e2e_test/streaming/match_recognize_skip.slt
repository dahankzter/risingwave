# Streaming MATCH_RECOGNIZE AFTER MATCH SKIP TO LAST <var>: resume matching at the match's last row
# bound to a variable, which (with overlapping DEFINEs) produces overlapping matches that PAST LAST
# ROW would not.

statement ok
set streaming_parallelism = 1;

statement ok
set rw_implicit_flush to true;

statement ok
create table t (id int, ts int, v int, watermark for ts as ts - 10) append only;

# Every positive row satisfies both `a` and `b`, so pattern (a b b) can match overlapping windows.
# SKIP TO LAST b resumes at each match's last `b`, giving matches starting at rows 0 and 2.
statement ok
create materialized view mv_skip as
select * from t match_recognize (
  partition by id
  order by ts
  measures first(a.v) as a0, last(b.v) as b_last, count(*) as n
  one row per match
  after match skip to last b
  pattern (a b b)
  define a as a.v > 0, b as b.v > 0
)
emit on window close;

# id=1: six rising rows; sentinel advances the watermark so all become final.
# matches (SKIP TO LAST b): [10,20,30] and [30,40,50].
statement ok
insert into t values
  (1, 1, 10), (1, 2, 20), (1, 3, 30), (1, 4, 40), (1, 5, 50), (1, 6, 60),
  (0, 100, 0);

query IIII rowsort
select * from mv_skip;
----
1 10 30 3
1 30 50 3

statement ok
drop materialized view mv_skip;

statement ok
drop table t;

# Finalization straddle under SKIP TO NEXT ROW (overlapping matches): pattern (a a) over three
# consecutive qualifying rows yields the overlapping matches (r1,r2) and (r2,r3). Once the watermark
# passes all three, (r1,r2) is complete and evictable while (r2,r3) ends at the safe boundary and is
# held (it could still be the prefix of nothing — but its start stays alive), so the eviction
# boundary is r2 — strictly INSIDE the already-frozen (r1,r2)'s span. The executor must not rebase
# the incremental matcher across a straddled boundary (finalize_before_seq's no-straddle contract);
# it drops and rebuilds instead. Pins: the eviction survives (no panic, no corrupted matcher
# bookkeeping), the first match is emitted at the first watermark, and the held match is emitted —
# exactly once — when a later non-matching row closes it.

statement ok
create table t_skip_straddle (id int, ts int, v int, watermark for ts as ts - 10) append only;

statement ok
create materialized view mv_skip_straddle as
select * from t_skip_straddle match_recognize (
  partition by id
  order by ts
  measures first(a.ts) as first_ts, last(a.ts) as last_ts
  one row per match
  after match skip to next row
  pattern (a a)
  define a as a.v > 0
)
emit on window close;

# Three qualifying rows; the sentinel (id 0, ts 14) advances the watermark to 4, strictly past them
# (finality is strict — a row AT the watermark is not yet safe), so the straddle-shaped eviction
# runs: (1,2) finalizes and emits, (2,3) ends at the safe boundary and is held.
statement ok
insert into t_skip_straddle values (1, 1, 5), (1, 2, 6), (1, 3, 7), (0, 14, 0);

query II rowsort
select first_ts, last_ts from mv_skip_straddle;
----
1 2

# A non-matching row (v = -1) closes the held (2,3) match strictly before the new safe boundary; the
# rebuilt matcher (dropped at the straddle eviction above) must emit it exactly once and keep the
# partition working — proving the finalization survived with intact bookkeeping.
statement ok
insert into t_skip_straddle values (1, 4, -1), (0, 24, 0);

query II rowsort
select first_ts, last_ts from mv_skip_straddle;
----
1 2
2 3

statement ok
drop materialized view mv_skip_straddle;

statement ok
drop table t_skip_straddle;
