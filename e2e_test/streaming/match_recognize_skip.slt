# Streaming MATCH_RECOGNIZE AFTER MATCH SKIP TO LAST <var>: resume matching at the match's last row
# bound to a variable, which (with overlapping DEFINEs) produces overlapping matches that PAST LAST
# ROW would not.

statement ok
set streaming_parallelism = 1;

statement ok
set rw_implicit_flush to true;

statement ok
create table t (id int, ts int, v int, watermark for ts as ts - 10) append only;

# Every positive row satisfies both `a` and `b`, so pattern (a b b) can match overlapping windows.
# SKIP TO LAST b resumes at each match's last `b`, giving matches starting at rows 0 and 2.
statement ok
create materialized view mv_skip as
select * from t match_recognize (
  partition by id
  order by ts
  measures first(a.v) as a0, last(b.v) as b_last, count(*) as n
  one row per match
  after match skip to last b
  pattern (a b b)
  define a as a.v > 0, b as b.v > 0
)
emit on window close;

# id=1: six rising rows; sentinel advances the watermark so all become final.
# matches (SKIP TO LAST b): [10,20,30] and [30,40,50].
statement ok
insert into t values
  (1, 1, 10), (1, 2, 20), (1, 3, 30), (1, 4, 40), (1, 5, 50), (1, 6, 60),
  (0, 100, 0);

query IIII rowsort
select * from mv_skip;
----
1 10 30 3
1 30 50 3

statement ok
drop materialized view mv_skip;

statement ok
drop table t;

# Overlapping terminal matches at the boundary, under SKIP TO NEXT ROW: pattern (a a) over three
# consecutive qualifying rows yields the overlapping matches (r1,r2) and (r2,r3). Once the watermark
# passes all three, BOTH are final in the same pass: (r1,r2) is followed by a decided row, and
# (r2,r3), though it ends exactly at the boundary, is TERMINAL — the fixed (a a) cannot extend — so
# it is emitted rather than held (see match_recognize_terminal_finality.slt).
#
# Historical note: before terminal finality, (r2,r3) was held at the boundary while (r1,r2) was
# consumed, which put the eviction boundary strictly INSIDE the frozen (r1,r2)'s span — the
# "finalization straddle" that finalize_before_seq's no-straddle contract guards against. With
# terminal boundary matches emitted, that executor-reachable straddle shape no longer occurs for
# fixed patterns (an extendable overlap swallows the earlier rows into one greedy match instead);
# the contract survives as defense-in-depth and is pinned at the unit level. Pins here: both
# overlapping matches emit in one pass, exactly once each, and the partition keeps working after
# the boundary-consuming eviction.

statement ok
create table t_skip_straddle (id int, ts int, v int, watermark for ts as ts - 10) append only;

statement ok
create materialized view mv_skip_straddle as
select * from t_skip_straddle match_recognize (
  partition by id
  order by ts
  measures first(a.ts) as first_ts, last(a.ts) as last_ts
  one row per match
  after match skip to next row
  pattern (a a)
  define a as a.v > 0
)
emit on window close;

# Three qualifying rows; the sentinel (id 0, ts 14) advances the watermark to 4, strictly past them
# (finality is strict — a row AT the watermark is not yet safe). (1,2) emits with a decided row
# after it; (2,3) ends at the boundary but is terminal, so it emits in the same pass.
statement ok
insert into t_skip_straddle values (1, 1, 5), (1, 2, 6), (1, 3, 7), (0, 14, 0);

query II rowsort
select first_ts, last_ts from mv_skip_straddle;
----
1 2
2 3

# A later non-matching row (v = -1) and a further watermark: nothing new matches, nothing is
# re-emitted — the boundary-consuming eviction left the partition's bookkeeping intact, and both
# matches appear exactly once.
statement ok
insert into t_skip_straddle values (1, 4, -1), (0, 24, 0);

query II rowsort
select first_ts, last_ts from mv_skip_straddle;
----
1 2
2 3

statement ok
drop materialized view mv_skip_straddle;

statement ok
drop table t_skip_straddle;
