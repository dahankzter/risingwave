# MATCH_RECOGNIZE emission modes: EMIT ON WINDOW CLOSE vs the plain form.
#
# Both forms are valid. With EMIT ON WINDOW CLOSE the operator emits only FINAL matches, at the
# watermark — a match is delivered once no future row can change it, and never revised. The plain
# (default-emit) form plans as emit-on-update: a provisional changelog is emitted at every barrier,
# computed over the whole buffer ("as if input ended now"), and later input may revise a match
# (Delete+Insert on the same hidden `_match_id`). This file contrasts the two modes on identical
# input: the same detector over the same rows, asserting WHEN each MV shows the match. Scenario
# mirrors match_recognize_within_boundary.slt (proven expectations for the final row).

statement ok
set streaming_parallelism = 1;

statement ok
set rw_implicit_flush to true;

statement ok
drop materialized view if exists mv_eowc;

statement ok
drop materialized view if exists mv_eou_contrast;

statement ok
drop table if exists t_eowc;

statement ok
create table t_eowc (id int, ts int, v int, watermark for ts as ts - 1) append only;

# The plain form succeeds, planning as emit-on-update (the reservation that once rejected it was
# lifted when the emit-on-update mode landed).
statement ok
create materialized view mv_eou_contrast as
select * from t_eowc match_recognize (
  partition by id
  order by ts
  measures a.ts as a_ts, b.v as dip
  one row per match
  after match skip past last row
  pattern (a b)
  within 3
  define a as a.v > 0, b as b.v < 0
);

statement ok
create materialized view mv_eowc as
select * from t_eowc match_recognize (
  partition by id
  order by ts
  measures a.ts as a_ts, b.v as dip
  one row per match
  after match skip past last row
  pattern (a b)
  within 3
  define a as a.v > 0, b as b.v < 0
)
emit on window close;

# a@10, b@13: span exactly the WITHIN bound -> a valid match. Implicit flush is on, so each insert
# is its own epoch/barrier — the plain MV gets a provisional diff opportunity per statement. The
# sentinel below (ts 15, lateness 1) advances the watermark to 14, strictly past the match's
# deadline of 13.
statement ok
insert into t_eowc values (1, 10, 5);

statement ok
insert into t_eowc values (1, 13, -1);

# CONTRAST, mid-stream (watermark = 13 - 1 = 12: a@10 is safe, b@13 is NOT). The plain MV computes
# its provisional set over the WHOLE buffer — both rows, no watermark needed — so the complete
# (a b) match is ALREADY visible, provisionally.
query III rowsort
select * from mv_eou_contrast;
----
1 10 -1

# The EOWC MV matches only the watermark-safe prefix ([a@10] alone — no complete match) and emits
# nothing until the match is final: still empty here.
query III rowsort
select * from mv_eowc;
----

# Sentinel (partition 2, ts 15) advances the watermark to 14, strictly past the match's WITHIN
# deadline of 13 (10 + 3). No future row can legally extend it, so it is final in both modes.
statement ok
insert into t_eowc values (2, 15, 0);

# EOWC now emits the final match — identical inputs and expectations as the plain-MV boundary test.
query III rowsort
select * from mv_eowc;
----
1 10 -1

# The plain MV's provisional row finalizes in place: its rows evict and it leaves the diff base
# WITHOUT a retraction, so the row downstream is stable and byte-identical to the provisional one.
query III rowsort
select * from mv_eou_contrast;
----
1 10 -1

statement ok
drop materialized view mv_eowc;

statement ok
drop materialized view mv_eou_contrast;

statement ok
drop table t_eowc;
